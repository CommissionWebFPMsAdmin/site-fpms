---
import LayoutCercle from "@layouts/LayoutCercle.astro";
import { Image } from "astro:assets";
import { LinkType } from "@components/Links.astro";

import _Scientifique from "@images/cercles/scientifique.jpg";
import imageComite from "@images/comites/scientifique.jpg";
import _Lapinou from "@images/locaux/700-lapinou.jpg";

const cercle = "Cercle Scientifique";

const video = {
  url: "https://www.youtube.com/watch?v=EUW6xxHjwIY",
  promo: 185, // Promo durant laquelle la vidéo a été tournée
};

const comite = [
  { role: "Président", name: "Martin Vleminck" },
  { role: "Trésorier", name: "Antonin Meunier" },
];

const links: { name: string; type: LinkType; url: string }[] | undefined = [
  {
    name: "Facebook",
    type: LinkType.FACEBOOK,
    url: "https://www.facebook.com/profile.php?id=100064300376795",
  },
];
---

<LayoutCercle
  cercle={cercle}
  imageCercle={_Scientifique}
  video={video}
  comite={comite}
  imageComite={imageComite}
  links={links}
>
  <section class="space-y-2 text-justify">
    <h2 class="text-2xl font-medium">Description</h2>
    <div class="float-right mb-4 ml-6 w-full max-w-xs sm:max-w-sm">
      <Image
        class="h-full w-full rounded-xl object-cover shadow-lg"
        src={_Lapinou}
        alt="Lapinou du local 700 du Cercle Scientifique"
        quality={80}
        format="webp"
      />
      <p class="mt-2 text-center text-sm italic text-blue-900">
        Lapinou veille sur le local 700 du Cercle Scientifique.
      </p>
    </div>
    <p>
      On dit souvent qu'un ingénieur civil ne sait pas utiliser ses dix doigts
      et encore moins planter des clous... Le Cercle Scientifique est là pour y
      remédier !
    </p>
    <p>
      <strong
        >Le Cercle Scientifique est premièrement un cercle tourné vers l'aide
        aux étudiants et aux autres cercles de la Faculté.</strong
      > Comment peut-il vous aider ? Que cela soit pour de petites réparations dans
      votre kot comme un problème d'armoire ou encore un souci de fenêtre, <strong
        >le Cercle Scientifique est disponible tout au long de l'année pour vous
        venir en aide !</strong
      >
    </p>
    <p>
      Le Scientifique est aussi le cercle qui peut vous <strong
        >prêter gratuitement du matériel de bricolage de bonne qualité</strong
      > (tel que des visseuses, scies sauteuses, marteaux, pieds-de-biche, etc.)
      pour <strong>vos projets académiques ou personnels</strong>.
    </p>
    <p>
      Le Cercle Scientifique est également le cercle qui s'implique dans deux
      des <strong>trois méchouis annuels</strong> et qui organise chaque année depuis
      10 ans maintenant la <strong>BGT (Big Guinze Theory)</strong> avec l'aide du
      <a class="text-blue-900 underline" href="/cercles&commissions/radio-extra"
        >Cercle Radio Extra</a
      > et du <a
        class="text-blue-900 underline"
        href="/cercles&commissions/magellan">Cercle Magellan</a
      >. Son plus grand projet annuel reste <strong
        >la construction du char</strong
      > qui défile fièrement dans les rues de Mons depuis plus de 50 ans lors du
      <strong>cortège des étudiants le jour du Baptême</strong> !
    </p>
  </section>
</LayoutCercle>
